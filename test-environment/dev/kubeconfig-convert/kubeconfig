apiVersion: v1
kind: Config
current-context: $current_context
contexts:
  - name: $current_context
    context:
      cluster: $current_context
      user: $account_name
      namespace: $namespace
clusters:
  - name: $current_context
    cluster:
      certificate-authority-data: $authority_data
      server: $cluster_server
users: 
  - name: $account_name
    user: 
      token: $user_token