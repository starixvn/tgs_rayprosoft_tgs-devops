# 使用 gitlab-runner:alpine 作為基礎映像
FROM alpine:latest

# 更新包清單並安裝基本工具
RUN apk update && \
    apk add --no-cache curl bash jq

# 安裝 kubectl
RUN curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" && \
    chmod +x kubectl && \
    mv kubectl /usr/local/bin/

# 安裝 Helm
RUN curl -LO https://get.helm.sh/helm-v3.11.2-linux-amd64.tar.gz && \
    tar -zxvf helm-v3.11.2-linux-amd64.tar.gz && \
    mv linux-amd64/helm /usr/local/bin/ && \
    rm -rf linux-amd64 helm-v3.11.2-linux-amd64.tar.gz

# 安裝 yq
RUN curl -sL https://github.com/mikefarah/yq/releases/download/v4.16.1/yq_linux_amd64 -o /usr/bin/yq && \
    chmod +x /usr/bin/yq

# 設置工作目錄
WORKDIR /workspace