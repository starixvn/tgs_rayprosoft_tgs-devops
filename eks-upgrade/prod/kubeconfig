apiVersion: v1
kind: Config
current-context: $account_name
contexts:
- name: $account_name
  context:
    cluster: $current_context
    user: $account_name
    namespace: $namespace
clusters:
- name: $account_name
  cluster:
    certificate-authority-data: $authority_data
    server: $cluster_server
users: 
- name: $account_name
  user: 
    token: $user_token